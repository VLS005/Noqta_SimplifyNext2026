# In your terminal, run: cp .env.example .env to copy 
# replace the placeholders with your own credentials 

# ─── App ──────────────────────────────────────────────────────────────
APP_ENV=development          
LOG_LEVEL=INFO               

# ─── AWS Core ────────────────────────────────────────────────────────
# Get these from AWS IAM → Users → Security credentials → Create access key
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""
AWS_REGION=""

# ─── Gemini LLM ──────────────────────────────────────────────────────────
# Get this from Google AI Studio
GEMINI_API_KEY=""

# ─── Google Maps / Routes API ────────────────────────────────────────────
# Get this from Google Cloud Console → APIs & Services → Credentials
# Enable: Directions API, Places API
GOOGLE_MAPS_API_KEY=""

# ─── DynamoDB (persistence) ──────────────────────────────────────────
DYNAMODB_TABLE_NAME="DoraDB"
DYNAMODB_ENDPOINT_URL=""
# Set this for local development with Docker:
# DYNAMODB_ENDPOINT_URL=http://localhost:8001


# ─── Business logic ──────────────────────────────────────────────────
VISION_PROXIMITY_GATE_M=5.0
MAX_ROUTE_CANDIDATES=3
FINE_MOTOR_BUFFER_S=30
