flowchart TD
    GPS["GPS / IMU Sensors"]
    PA["Personalisation Agent (baseline pace)"]
    RAstart["Routing Agent (journey start ping)"]

    RAstart --> Start["start_journey()"]
    Start --> Loop["Polling Loop (ingest)"]
    GPS --> Loop
    PA --> Loop

    Loop --> Detector["PatternDetector<br/>(circling / too_slow / wall_hugging)"]
    Detector -- "none" --> Loop
    Detector -- "pattern detected" --> Cooldown{"In cooldown?"}

    Cooldown -- "yes" --> Loop
    Cooldown -- "no" --> Decision["DecisionEngine"]

    Decision --> Weather{"Bad weather?"}
    Weather -- "yes" --> Reroute1["Reroute: bad_weather"]
    Weather -- "no" --> Obstruction{"Obstruction visible?"}
    Obstruction -- "yes" --> Reroute2["Reroute: obstruction"]
    Obstruction -- "no" --> Prompt["Minimally-audible prompt<br/>+ find anchor point"]
    Prompt --> Confirm{"User confirms lost?"}
    Confirm -- "yes" --> Reroute3["Reroute: disoriented"]
    Confirm -- "no (false alarm)" --> Loop

    Reroute1 --> Payload["RerouteRequest JSON<br/>(api_schemas/routing_payload.py)"]
    Reroute2 --> Payload
    Reroute3 --> Payload
    Payload --> RoutingAgent["Routing Agent"]

    Weather -.-> WeatherAPI[("Weather Client")]
    Obstruction -.-> VisionAPI[("Vision Client<br/>(triggered snapshot)")]
    Prompt -.-> VisionAPI
