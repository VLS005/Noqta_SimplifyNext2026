# Copy this file to .env and fill in real values.
# .env itself should NEVER be committed to git (see .gitignore).

# -- Weather API (integrations/weather_client.py) ---------------------------
# e.g. OpenWeatherMap, or data.gov.sg for Singapore
WEATHER_API_KEY=
WEATHER_API_BASE_URL=

# -- Vision API (integrations/vision_client.py) ------------------------------
# e.g. Google Cloud Vision, or an AWS Bedrock vision model
GOOGLE_VISION_API_KEY=
# If using a Google service account instead of an API key:
GOOGLE_APPLICATION_CREDENTIALS=

# -- Routing Agent transport (integrations/routing_client.py) ---------------
# Base URL only - the path (/api/inbound/obstruction) is appended in code.
# Set this to wherever your teammate's routing-orchestrator backend is
# actually running (check with her - her own config.py defaults to port
# 8010, but her README's uvicorn command example uses 8000, so confirm
# which one is actually live before assuming).
ROUTING_AGENT_BASE_URL=

# -- Personalisation Agent / shared data store -------------------------------
# If reading baseline pace from a shared DB/vector store (e.g. S3-backed)
PERSONALISATION_AGENT_ENDPOINT=

# -- Runtime tuning (optional overrides for config/settings.py) -------------
POLL_INTERVAL_SEC=5.0
ALERT_COOLDOWN_SEC=30.0
